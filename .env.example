# ---------------------------------------------------------------------------
# Coffee Shopp CRM — environment variables
# Copy this file to `.env` and adjust values for your environment.
# ---------------------------------------------------------------------------

# Database connection.
#
# DEV (default, zero-config): SQLite file in the prisma folder.
DATABASE_URL="file:./dev.db"
#
# PROD: PostgreSQL. Switch the provider in prisma/schema.prisma to "postgresql"
# and use a URL like the one below.
# DATABASE_URL="postgresql://user:password@localhost:5432/coffee_crm?schema=public"

# Secret used to sign session JWTs. Use a long random string in production.
AUTH_SECRET="dev-secret-change-me-to-a-long-random-string"

# App base URL (used for absolute links where needed).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
